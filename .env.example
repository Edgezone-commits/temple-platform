# ===========================================
# Shree Laxminarayan Mandir - Environment Variables (REFERENCE ONLY)
# ===========================================
# The app never reads this file. The real files are:
#   backend/.env         (copy backend/.env.example)
#   frontend/.env.local  (copy frontend/.env.example)
#   ai-services/.env     (copy ai-services/.env.example; only for running ingest on its own)
# Step-by-step instructions: MANUAL_STEPS.md

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key                 # safe for the browser
SUPABASE_SERVICE_KEY=your-service-role-key      # SECRET — backend/ai-services only

# --- "Ask the Pandit" (console.anthropic.com) — backend only ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# --- Backend ---
# Both are listed because a browser treats them as different origins.
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Frontend ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000       # no trailing /api
API_URL=http://localhost:8000                   # optional: server-side URL for admin actions
NEXT_PUBLIC_SITE_URL=http://localhost:3000
