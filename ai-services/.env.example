# ai-services/.env — only needed when running scripts/ingest.py on its own.
# When the FastAPI backend imports temple_rag it reads these same names from
# backend/.env instead, and scripts/ingest.py loads backend/.env too, so most
# people never create this file. Copy it when you want the ingest script to
# run with its own settings:
#   bash:        cp ai-services/.env.example ai-services/.env
#   PowerShell:  Copy-Item ai-services\.env.example ai-services\.env

# --- Supabase (required to ingest temple content from the database) ---------
SUPABASE_URL=https://your-project-ref.supabase.co
# SECRET - service role key, bypasses Row Level Security. Server-side only.
SUPABASE_SERVICE_KEY=your-service-role-key

# --- "Ask the Pandit" model (server-side only) -------------------------------
# Not needed for ingestion; only when this package answers questions.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Embeddings / vector store ----------------------------------------------
# Leave EMBEDDING_MODEL alone unless you know why. "hash" is a fake,
# non-semantic embedder used only by the offline tests.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=temple_kb
KNOWLEDGE_BASE_DIR=./knowledge_base

# --- Retrieval tuning (defaults shown; all optional) ------------------------
# RAG_TOP_K          how many passages to retrieve per question
# RAG_MIN_SIMILARITY below this cosine score a passage counts as irrelevant.
#                    Measured on the temple data with multilingual-e5-small:
#                    relevant passages scored >= 0.815, off-topic 0.74-0.79.
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.80
