APP_NAME="Shree Laxminarayan Mandir API"
APP_VERSION="1.0.0"
DEBUG=True
# Which website addresses may call this API. localhost and 127.0.0.1 are
# different origins to a browser, so both are listed for dev. In production,
# replace them with the real domain, e.g. ["https://laxminarayanmandir.org"].
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=paste_your_anon_key_here
# Server-only. Bypasses Row Level Security — never put this in the frontend.
SUPABASE_SERVICE_KEY=paste_your_service_role_key_here

# "Ask the Pandit" — Google AI Studio key (server-side only).
# Get one at https://aistudio.google.com/apikey  ·  Pricing: https://ai.google.dev/pricing
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MAX_TOKENS=2000      # longest answer the model may produce
# AGENT_MAX_TOOL_ROUNDS=4     # hard cap on agent<->tool loops per question
# LANGSMITH_API_KEY=          # optional tracing; off unless this is set
# Where the ChromaDB knowledge base lives (default: ../ai-services/chroma_db)
# CHROMA_PERSIST_DIR=../ai-services/chroma_db
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
