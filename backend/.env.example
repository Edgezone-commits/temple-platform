APP_NAME="Shree Laxminarayan Mandir API"
APP_VERSION="1.0.0"
DEBUG=True
ALLOWED_ORIGINS=["http://localhost:3000"]

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=paste_your_anon_key_here
# Server-only. Bypasses Row Level Security — never put this in the frontend.
SUPABASE_SERVICE_KEY=paste_your_service_role_key_here

# "Ask the Pandit" — Anthropic key from console.anthropic.com (server-side only)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Where the ChromaDB knowledge base lives (default: ../ai-services/chroma_db)
# CHROMA_PERSIST_DIR=../ai-services/chroma_db
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
